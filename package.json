{
  "name": "fabric-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "Fabric Analyzer desktop application",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hadi1171.fabricanalyzer",
    "productName": "Fabric Analyzer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Fabric-Analyzer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
